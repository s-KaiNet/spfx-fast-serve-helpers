{
  "name": "spfx-fast-serve-helpers",
  "version": "1.24.0",
  "description": "Vite-based dev server for SharePoint Framework 1.24.x (Heft) projects: fast start, HMR and React Fast Refresh inside a real SharePoint page",
  "type": "module",
  "bin": {
    "fast-serve": "lib/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc -p src/runtime/tsconfig.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/runtime/tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "spfx",
    "sharepoint",
    "vite",
    "hmr",
    "fast-refresh",
    "heft"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-KaiNet/spfx-fast-serve-helpers.git"
  },
  "author": "Sergei Sergeev (https://github.com/s-KaiNet)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/s-KaiNet/spfx-fast-serve-helpers/issues"
  },
  "homepage": "https://github.com/s-KaiNet/spfx-fast-serve-helpers#readme",
  "devDependencies": {
    "@microsoft/sp-css-loader": "1.24.1",
    "@rushstack/heft-config-file": "0.20.16",
    "@rushstack/heft-sass-plugin": "1.5.0",
    "@rushstack/rig-package": "0.7.3",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rolldown": "1.2.19",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@rushstack/debug-certificate-manager": "^1.7.33",
    "@rushstack/terminal": "^0.24.8",
    "@vitejs/plugin-react": "^6.3.0",
    "es-module-lexer": "^3.0.4",
    "magic-string": "^1.4.5",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "vite": "^8.3.8"
  }
}
