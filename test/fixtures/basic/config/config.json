{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "hello-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/hello/HelloWebPart.js",
          "manifest": "./src/webparts/hello/HelloWebPart.manifest.json"
        }
      ]
    },
    "banner-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/banner/BannerApplicationCustomizer.js",
          "manifest": "./src/extensions/banner/BannerApplicationCustomizer.manifest.json"
        }
      ]
    }
  },
  "externals": {
    "jquery": "https://code.jquery.com/jquery-3.7.1.min.js",
    "legacy-plugin": {
      "path": "./assets/legacy-plugin.js",
      "globalName": "LegacyPlugin",
      "globalDependencies": ["jquery"]
    },
    "@microsoft/sp-core-library": "https://example.invalid/sp-core-library.js",
    "missing-file": "./assets/missing.js",
    "orphan-plugin": {
      "path": "https://example.invalid/orphan.js",
      "globalName": "Orphan",
      "globalDependencies": ["not-defined"]
    }
  },
  "localizedResources": {
    "HelloWebPartStrings": "lib/webparts/hello/loc/{locale}.js",
    "ControlStrings": "node_modules/@pnp/controls/lib/loc/{locale}.js",
  }
}
